# Copy this file to .env and fill in your values
# Get a free Groq API key at: https://console.groq.com

GROQ_API_KEY=your_groq_key_here
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_USER=
SMTP_PASS=

# Tail-based sampling configuration (OTel Collector)
# Percentage of healthy/fast traces to retain (e.g., 10 for 10% sample, dropping 90%)
TRACE_SAMPLE_PERCENTAGE=10
# Latency threshold in ms (traces longer than this are 100% retained)
TRACE_LATENCY_THRESHOLD_MS=500