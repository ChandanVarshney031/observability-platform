{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway service with OpenTelemetry instrumentation",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node --import ./tracing.js app.js",
    "dev": "node --import ./tracing.js --watch app.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.2",
    "@opentelemetry/sdk-node": "^0.50.0",
    "@opentelemetry/auto-instrumentations-node": "^0.46.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.50.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.50.0",
    "@opentelemetry/sdk-metrics": "^1.21.0",
    "@opentelemetry/sdk-trace-node": "^1.21.0",
    "@opentelemetry/resources": "^1.21.0",
    "@opentelemetry/semantic-conventions": "^1.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
