# ==============================================================================
# Observability Platform Dashboard Environment Variables
# ==============================================================================
#
# IMPORTANT: This project is 100% open-source and runs entirely locally. 
# There are NO API keys required (e.g., no OpenAI keys, no Datadog keys).
# All AI analysis is performed locally using Ollama + Llama 3.
#
# ==============================================================================

# The URL of the Query API backend. 
# If running locally via docker-compose, this should point to your local API.
# If deployed to EC2, this should be the public IP or domain of the API server.
REACT_APP_API_URL=http://localhost:4000
